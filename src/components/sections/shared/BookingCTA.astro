<section class="bg-color text-light pt-50 pb-50">
  <div class="container">
    <div class="row g-4 align-items-center">
      <div class="col-md-9">
        <h3 class="mb-0 fs-32">Ready to Book Your Appointment?</h3>
        <p class="mb-0">
          Contact us today to schedule your visit and take the first step toward a healthier
          smile.
        </p>
      </div>
      <div class="col-lg-3 text-lg-end">
        <a class="btn-main fx-slide btn-line" href="/booking">
          <span>Book Appointment</span>
        </a>
      </div>
    </div>
  </div>
</section>
