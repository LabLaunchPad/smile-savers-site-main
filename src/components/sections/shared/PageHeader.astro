---
/* Iteration 3: PageHeader OWNS the repeated #subheader page-header block
   (16/17 pages, verified identical shells; blog/single keeps its bespoke h2
   variant). Props: title (h1), crumb (defaults to title), trail (extra crumbs,
   e.g. service pages pass [{ label: 'Services', href: '/services' }]). */
interface Crumb {
  label: string;
  href: string;
}
interface Props {
  title: string;
  crumb?: string;
  trail?: Crumb[];
}

const { title, crumb = title, trail = [] } = Astro.props;

// ponytail: BreadcrumbList mirrors only the visible crumb row; skipped when trail is empty.
const siteBase = (Astro.site ?? 'https://dentalsmilesavers.com').toString().replace(/\/$/, '');
const abs = (h: string) => new URL(h, `${siteBase}/`).href;
const crumbJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    ...trail.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.label, item: abs(c.href) })),
    { '@type': 'ListItem', position: trail.length + 2, name: crumb },
  ],
});
---

<section id="subheader" class="bg-color-op-1 text-center">
  <div class="container relative z-2">
    <div class="row align-items-center">
      <div class="col-lg-12">
        <h1 class="wow fadeInUp">{title}</h1>
        <div class="border-bottom my-3"></div>
        <ul class="crumb wow fadeInDown">
          <li>
            <a href="/">Home</a>
          </li>
          {
            trail.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))
          }
          <li class="active">{crumb}</li>
        </ul>
        {trail.length > 0 && <script is:inline type="application/ld+json" set:html={crumbJson} />}
      </div>
    </div>
  </div>
</section>
