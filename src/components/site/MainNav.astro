---
// Iteration 1: markup isolation — MainNav OWNS the #mainmenu list verbatim.
// Iteration 2: aria-current marks the current page (additive attribute only;
// all legacy selectors/classes/URLs byte-identical).
const path = Astro.url.pathname;
const cur = (h: string): 'page' | undefined =>
  h === path || (h !== '/' && (path === h || path.startsWith(h + '/'))) ? 'page' : undefined;
---
<div class="de-flex-col header-col-mid">
  {/* mainemenu begin */}
  <ul id="mainmenu">
    <li>
      <a class="menu-item" href="/" aria-current={cur('/')}>
        Home
      </a>
    </li>
    <li>
      <a class="menu-item" href="/services" aria-current={cur('/services')}>
        Services
      </a>
