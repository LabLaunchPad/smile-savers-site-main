---
import MainNav from './site/MainNav.astro';
import HeaderActions from './site/HeaderActions.astro';

interface Props {
  headerClass?: string;
  useHeaderInner?: boolean;
}

const { headerClass = 'transparent scroll-light', useHeaderInner = false } = Astro.props;
const isLightHeader = headerClass.includes('header-light');
const rowClassName = useHeaderInner ? 'de-flex sm-pt10 header-inner' : 'de-flex sm-pt10';
---

<header class={headerClass} data-base-class={headerClass}>
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class={rowClassName}>
          <div class="de-flex-col">
            {/* logo begin */}
            <div id="logo">
              <a href="/" aria-label="Smile Savers Dental — home">
                <img
                  class="logo-main logo"
                  src="/images/logo-white.svg"
                  alt="Smile Savers Dental — home"
                />
                <img class="logo-scroll logo-2" src="/images/logo.svg" alt="Smile Savers Dental" />
                <img
                  class="logo-mobile"
                  src={isLightHeader ? '/images/logo.svg' : '/images/logo-white.svg'}
                  alt="Smile Savers Dental"
                />
              </a>
            </div>
            {/* logo end */}
          </div>
          <MainNav />
          <HeaderActions />
        </div>
      </div>
    </div>
  </div>
</header>
