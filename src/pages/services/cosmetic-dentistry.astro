---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/sections/shared/PageHeader.astro';
import BookingCTA from '../../components/sections/shared/BookingCTA.astro';

export const prerender = true;

const reasons = [
  'Experienced cosmetic dentists with an eye for detail and artistry',
  'Advanced technology, including digital smile design and mock-up previews',
  'Customized treatment plans tailored to your aesthetic goals and lifestyle',
  'Gentle techniques with a focus on patient comfort and minimal discomfort',
  'Natural-looking results that enhance your facial features and confidence',
  'Comprehensive smile solutions—from simple touch-ups to full makeovers',
  'Clean, modern clinic environment with a warm and welcoming team',
];

const treatments = [
  {
    h: 'Teeth Whitening',
    p: 'In-office treatment under 1 hour, plus take-home trays. Up to 8 shades lighter.',
  },
  { h: 'Porcelain Veneers', p: 'Wafer-thin ceramic shells. Last 10-20 years.' },
  { h: 'Smile Makeovers', p: 'Digital smile design preview before treatment.' },
  { h: 'Dental Bonding', p: 'One visit, no lab needed.' },
  { h: 'Invisalign', p: 'Straighten discreetly as part of your makeover.' },
];

const quotes = [
  {
    text: 'Dr. Bhagat has been my family dentist for over 15 years. He remembered every detail about my dental history without checking notes. That level of care is rare.',
    name: 'Sofia R.',
  },
  {
    text: 'Excellent care and professional staff. My teeth have never looked better!',
    name: 'John D.',
  },
];

const faqs = [
  {
    q: 'How much whiter will my teeth get?',
    a: 'Professional whitening at Smile Savers uses prescription-strength gel and typically lightens teeth 4–8 shades in a single visit — far more than over-the-counter kits.',
    id: 'accordion-a1',
  },
  {
    q: 'How long do veneers last?',
    a: "Porcelain veneers typically last 10–20 years with good oral hygiene and routine check-ups. We'll give you care instructions to maximise their lifespan.",
    id: 'accordion-a2',
  },
  {
    q: 'Is whitening safe for sensitive teeth?',
    a: 'Yes. We offer desensitising treatments alongside whitening and tailor the gel concentration to your sensitivity level. Many patients with sensitive teeth complete treatment comfortably.',
    id: 'accordion-a3',
  },
  {
    q: 'Can I whiten if I have crowns or fillings?',
    a: "Whitening works on natural enamel only. If you have existing restorations, we'll discuss how to achieve a uniform shade across your whole smile.",
    id: 'accordion-a4',
  },
];
---

<Layout
  title="Cosmetic Dentistry — Smile Savers Dental"
  description="Cosmetic dentistry in Woodside, NY: whitening, veneers and smile makeovers. Smile Savers Dental, (718) 956-8400."
  headerClass="transparent header-light"
>
  <PageHeader title="Cosmetic Dentistry" trail={[{ label: 'Services', href: '/services' }]} />

  <section>
    <div class="container">
      <div class="row g-4 align-items-center">
        <div class="col-lg-7">
          <div class="relative">
            <div class="w-100 pe-5 pb-5 wow scaleIn">
              <img src="/images/misc/l2.webp" class="w-100 rounded-1" alt="" />
            </div>
            <div
              class="bg-color rounded-1 text-light w-50 p-4 abs end-0 bottom-0 z-2 soft-shadow wow scaleIn"
              data-wow-delay=".2s"
            >
              <i class="fa fa-quote-left fs-32 abs"></i>
              <h4 class="ps-50">Your natural beauty begins with a confident smile</h4>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="ps-lg-3">
            <div class="subtitle id-color wow fadeInUp" data-wow-delay=".2s">
              Cosmetic Dentistry
            </div>
            <h2 class="wow fadeInUp" data-wow-delay=".4s">
              Enhancing Your Smile with Art and Precision
            </h2>
            <p class="mb-0 wow fadeInUp" data-wow-delay=".6s">
              Transform your smile with teeth whitening, porcelain veneers, and full smile makeovers
              tailored to your goals.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-dark text-light">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-5">
          <div class="subtitle id-color wow fadeInUp" data-wow-delay=".0s">
            Why Choose Us
          </div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Why Choose Our Cosmetic Dental Services?
          </h2>
        </div>

        <div class="col-lg-7">
          <ul class="ul-check fs-500">
            {reasons.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4 justify-content-center">
        <div class="col-lg-8 text-center">
          <div class="subtitle wow fadeInUp mb-3">Cosmetic Dentistry</div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Cosmetic Treatments We Offer
          </h2>
        </div>
      </div>

      <div class="row g-4">
        {treatments.map((t) => (
          <div class="col-lg-3 col-md-6">
            <div class="border-gray p-40 h-100 rounded-1">
              <div class="relative wow fadeInUp">
                <h4>{t.h}</h4>
                <p class="mb-0">{t.p}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-color-op-2 no-top no-bottom overflow-hidden">
    <div class="container-fluid position-relative half-fluid">
      <div class="container">
        <div class="row">
          {/* Image */}
          <div class="col-lg-6 position-lg-absolute left-half h-100">
            <div
              class="image"
              style="background-image: url(/images/misc/l3.webp); background-position: center; background-size: cover;"
            ></div>
          </div>
          {/* Text */}
          <div class="col-lg-5 offset-lg-7">
            <div class="py-5 my-5">
              <div class="owl-single-dots owl-carousel owl-theme">
                {quotes.map((q) => (
                  <div class="item">
                    <i class="icofont-quote-left id-color fs-40 mb-4 wow fadeInUp"></i>
                    <h3 class="mb-4 wow fadeInUp fs-32">{q.text}</h3>
                    <span class="wow fadeInUp">{q.name}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-light">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-5">
          <div class="subtitle id-color wow fadeInUp" data-wow-delay=".0s">
            Everything You Need to Know
          </div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="col-lg-7">
          <div class="accordion s2 wow fadeInUp">
            <div class="accordion-section">
              {faqs.map((f) => (
                <>
                  <div class="accordion-section-title" data-tab={'#' + f.id}>
                    {f.q}
                  </div>
                  <div class="accordion-section-content" id={f.id}>
                    {f.a}
                  </div>
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>
