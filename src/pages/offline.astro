---
import Layout from '../layouts/Layout.astro';
import { practice } from '../data/practice';

export const prerender = true;
---

<Layout
  title={`Offline — ${practice.name}`}
  description="You appear to be offline."
  headerClass="transparent header-light"
>
  <section class="text-center">
    <div class="container relative z-2">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="subtitle wow fadeInUp mb-3">Connection lost</div>
          <h1 class="wow fadeInUp" data-wow-delay=".2s">
            You're offline
          </h1>
          <p class="wow fadeInUp" data-wow-delay=".3s">
            It looks like your internet connection dropped. For dental emergencies, call us
            directly:
          </p>
          <a class="btn-main fx-slide wow fadeInUp" data-wow-delay=".4s" href={practice.phone.href}>
            <span>{practice.phone.display}</span>
          </a>
          <div class="spacer-single"></div>
          <button
            type="button"
            class="btn-main btn-line wow fadeInUp"
            data-wow-delay=".5s"
            onclick="window.location.reload()"
          >
            <span>Try again</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
