---
import Layout from '../layouts/Layout.astro';

export const prerender = true;

interface Post {
  img: string;
  day: string;
  month: string;
  title: string;
  author: string;
  tag: string;
}

const posts: Post[] = [
  {
    img: '/images/blog/l1.webp',
    day: '20',
    month: 'Jun',
    title: 'Discover 10 Easy Tips to Maintain a Healthier and Brighter Smile Today',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
  {
    img: '/images/blog/l2.webp',
    day: '20',
    month: 'Jun',
    title: 'Is Teeth Whitening Safe and Effective? Here’s What You Need to Know',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
  {
    img: '/images/blog/l3.webp',
    day: '20',
    month: 'Jun',
    title: 'Braces vs. Clear Aligners: Which Orthodontic Option Fits You Best?',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
  {
    img: '/images/blog/l4.webp',
    day: '20',
    month: 'Jun',
    title: 'What to Expect During Your First Visit to the Dentist’s Office',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
  {
    img: '/images/blog/l5.webp',
    day: '20',
    month: 'Jun',
    title: '5 Warning Signs You May Need a Root Canal and Why It’s Not So Bad',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
  {
    img: '/images/blog/l6.webp',
    day: '20',
    month: 'Jun',
    title: 'How to Protect Your Child’s Teeth and Prevent Cavities Early On',
    author: 'Brunilda Doniger',
    tag: 'Health Care',
  },
];
---

<Layout
  title="Our Blog — Smile Savers Dental"
  description="Dental tips and news from Smile Savers Dental in Woodside, NY. Oral health advice from your local dentists."
  headerClass="transparent header-light"
>
  <section id="subheader" class="bg-color-op-1 text-center">
    <div class="container relative z-2">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <h1 class="wow fadeInUp">Our Blog</h1>
          <div class="border-bottom my-3"></div>
          <ul class="crumb wow fadeInDown">
            <li>
              <a href="/">Home</a>
            </li>
            <li class="active">Blog</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4 gy-5">
        {posts.map((p) => (
          <div class="col-lg-4">
            <div class="overflow-hidden">
              <div class="relative">
                <div class="abs z-2 bg-color rounded-2 text-white p-3 pb-2 m-4 text-center fw-600">
                  <h4 class="fs-36 mb-0 lh-1">{p.day}</h4>
                  <span>{p.month}</span>
                </div>
                <img src={p.img} class="rounded-1 w-100" alt="" />
              </div>

              <div class="pt-4">
                <a href="/blog/single">
                  <h4 class="mb-3">{p.title}</h4>
                </a>
                <div>
                  <img src="/images/testimonial/1.webp" class="w-20px me-2 circle" alt="" />
                  <div class="d-inline fs-14 me-3">{p.author}</div>
                  <div class="d-inline fs-14">
                    <i class="icofont-tags id-color me-2"></i>
                    {p.tag}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
