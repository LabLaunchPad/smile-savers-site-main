---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.tsx';

export const prerender = true;
---

<Layout
  title="Gallery — Smile Savers Dental"
  description="Browse our Woodside, NY dental office and smile transformations. Smile Savers Dental, (718) 956-8400."
  headerClass="transparent header-light"
>
  <section id="subheader" class="bg-color-op-1 text-center">
    <div class="container relative z-2">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <h1 class="wow fadeInUp">Gallery</h1>
          <div class="border-bottom my-3"></div>
          <ul class="crumb wow fadeInDown">
            <li>
              <a href="/">Home</a>
            </li>
            <li class="active">Gallery</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="section-gallery" class="bg-light">
    <div class="container">
      <GalleryGrid client:load />
    </div>
  </section>
</Layout>
