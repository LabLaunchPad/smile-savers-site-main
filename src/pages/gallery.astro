---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/shared/PageHeader.astro';
import GalleryGrid from '../components/GalleryGrid.tsx';

export const prerender = true;
---

<Layout
  title="Gallery — Smile Savers Dental"
  description="Browse our Woodside, NY dental office and smile transformations. Smile Savers Dental, (718) 956-8400."
  headerClass="transparent header-light"
>
  <PageHeader title="Gallery" />

  <section id="section-gallery" class="bg-light">
    <div class="container">
      <GalleryGrid client:load />
    </div>
  </section>
</Layout>
