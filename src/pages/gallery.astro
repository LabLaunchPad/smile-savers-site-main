---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/shared/PageHeader.astro';
import GalleryGrid from '../components/GalleryGrid.tsx';

export const prerender = true;
---

<Layout
  title="Smile Gallery in Woodside, Queens | Smile Savers Dental"
  description="See real smile results and our Woodside dental office. Visit 32-02 53rd Pl, Woodside, NY 11377 — we speak all our Queens community languages."
  headerClass="transparent header-light"
>
  <PageHeader title="Gallery" />

  <section id="section-gallery" class="bg-light">
    <div class="container">
      <GalleryGrid client:load />
    </div>
  </section>
</Layout>
