---
import Layout from '../layouts/Layout.astro';
import { practice } from '../data/practice';

export const prerender = true;

const [lead, islam, li, avendano] = practice.roster;

const logos = ['aaid', 'agd', 'ao', 'ada', 'icoi', 'nyu'];
---

<Layout
  title="Smile Savers Dental — Dentist in Woodside, Queens, NY"
  description={`Pain-free family dentist in Woodside, Queens since 1987. Same-day CEREC crowns, implants and emergency care. Call ${practice.phone.display}.`}
  headerClass="transparent scroll-light"
>
  <section id="section-intro" class="text-light no-top no-bottom relative overflow-hidden">
    <div class="relative">
      <div class="abs abs-centered w-100 z-2">
        <div class="container">
          <div class="row g-4 align-items-center justify-content-between">
            <div class="col-lg-6">
              <div class="spacer-single sm-hide"></div>
              <div class="subtitle">Pain-Free Family Dentistry</div>
              <h1>Healthy Smiles with Gentle, Pain-Free Care in Woodside</h1>
              <a class="btn-main btn-line fx-slide" href="/booking">
                <span>Book Appointment</span>
              </a>
              <p class="hero-trust mt-3 mb-0">
                Same-day appointments — we speak all our Queens community languages.
              </p>
            </div>

            <div class="d-lg-flex align-items-center">
              <a
                class="google-badge"
                href="https://share.google/tZftkQc4AVNwEkHfn"
                target="_blank"
                rel="noopener"
                aria-label={`Smile Savers Dental on Google: rated ${practice.stats.rating} out of 5 from ${practice.stats.reviews} reviews`}
              >
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M23.5 12.3c0-.9-.1-1.5-.3-2.3H12v4.5h6.5c-.1 1.1-.8 2.7-2.4 3.8v.1l3.5 2.7h.1c2.2-2 3.8-5 3.8-8.8z"
                  ></path>
                  <path
                    fill="#34A853"
                    d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.6-2.8c-1 .7-2.4 1.2-4.3 1.2-3.3 0-6.1-2.2-7.1-5.3h-.1l-3.6 2.8v.1C3.2 21.4 7.3 24 12 24z"
                  ></path>
                  <path
                    fill="#FBBC05"
                    d="M4.9 14.2c-.2-.7-.3-1.4-.3-2.2s.1-1.5.3-2.2v-.1L1.3 6.9h-.1C.5 8.5 0 10.2 0 12s.5 3.5 1.2 5.1l3.7-2.9z"
                  ></path>
                  <path
                    fill="#EA4335"
                    d="M12 4.7c1.8 0 3.4.6 4.7 1.9l3.5-3.5C17.9 1.1 15.2 0 12 0 7.3 0 3.2 2.6 1.2 6.9l3.7 2.9c1-3.1 3.8-5.1 7.1-5.1z"
                  ></path>
                </svg>
                <span class="google-badge-rating">{practice.stats.rating}</span>
                <span class="d-flex fs-14 d-rating" aria-hidden="true">
                  <i class="fa fa-solid fa-star m-1" aria-hidden="true"></i>
                  <i class="fa fa-solid fa-star m-1" aria-hidden="true"></i>
                  <i class="fa fa-solid fa-star m-1" aria-hidden="true"></i>
                  <i class="fa fa-solid fa-star m-1" aria-hidden="true"></i>
                  <i class="fa fa-solid fa-star m-1" aria-hidden="true"></i>
                </span>
                <span class="google-badge-count"
                  >Based on {practice.stats.reviews} Google Reviews</span
                >
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mh-800">
        <div class="swiper wow scaleIn">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <div
                class="swiper-inner jarallax"
                style="background-image: url(/images/slider/1.jpg); background-position: center; background-size: cover; background-repeat: no-repeat;"
              >
                <div class="sw-overlay op-5"></div>
                <div class="gradient-edge-left z-2"></div>
              </div>
            </div>
            <div class="swiper-slide">
              <div
                class="swiper-inner jarallax"
                style="background-image: url(/images/slider/2.jpg); background-position: center; background-size: cover; background-repeat: no-repeat;"
              >
                <div class="sw-overlay op-5"></div>
                <div class="gradient-edge-left z-2"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-dark text-light pt-50 pb-30">
    <div class="container relative">
      <div class="row g-4 grid-divider">
        <div class="col-lg-4 col-md-6 mb-sm-30">
          <div class="d-flex justify-content-center">
            <i class="fs-60 id-color icon_phone"></i>
            <div class="ms-3">
              <h4 class="mb-0">Need Dental Services?</h4>
              <p>Call: {practice.phone.display}</p>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-sm-30">
          <div class="d-flex justify-content-center">
            <i class="fs-60 id-color icon_clock"></i>
            <div class="ms-3">
              <h4 class="mb-0">Opening Hours</h4>
              <p>{practice.hours.short}</p>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-sm-30">
          <div class="d-flex justify-content-center">
            <i class="fs-60 id-color icon_mail"></i>
            <div class="ms-3">
              <h4 class="mb-0">Email Us</h4>
              <p>{practice.email.address}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-5 pb-0 text-center relative">
    <p class="text-dark mb-4 wow fadeInUp">Credentials That Speak for Themselves</p>
    <div class="d-flex">
      <div class="de-marquee-list wow fadeInUp" data-wow-delay=".3s">
        {logos.map((n) => (
          <img src={`/images/logo/${n}.png`} class="mx-5" style="height:64px;width:auto" alt="" aria-hidden="true" />
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4 gx-5 align-items-center">
        <div class="col-md-3">
          <div class="rounded-1 overflow-hidden wow zoomIn">
            <img src="/images/misc/p1.webp" class="w-100 wow scaleIn" alt="" />
          </div>
        </div>

        <div class="col-lg-6">
          <div class="text-center">
            <div class="subtitle s2 mb-3 wow fadeInUp" data-wow-delay=".0s">
              About Us
            </div>
            <h2 class="wow fadeInUp" data-wow-delay=".2s">
              Trusted Woodside Dentists Delivering Gentle, Personalized Care Since 1987
            </h2>
            <a class="btn-main fx-slide wow fadeInUp" data-wow-delay=".4s" href="/booking">
              <span>Book Appointment</span>
            </a>
          </div>
        </div>

        <div class="col-lg-3">
          <div class="rounded-1 overflow-hidden wow zoomIn" data-wow-delay=".3s">
            <img src="/images/misc/p2.webp" class="w-100 wow scaleIn" alt="" data-wow-delay=".3s" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-color-op-1">
    <div class="container">
      <div class="row g-4 justify-content-center">
        <div class="col-lg-8 text-center">
          <div class="subtitle wow fadeInUp mb-3">Our Services</div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Complete Care for Every Smile
          </h2>
          <p class="col-lg-8 offset-lg-2 mb-0 wow fadeInUp">
            From routine cleanings to advanced restorations, we provide personalized dental
            solutions for patients of all ages.
          </p>
          <div class="spacer-single"></div>
          <div class="spacer-half"></div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-3 col-sm-6">
          <div class="hover">
            <div class="bg-white h-100 p-40 rounded-1">
              <img src="/images/icons/tooth-1.png" class="w-70px mb-3 wow scaleIn" alt="" />
              <div class="relative mt-4 wow fadeInUp">
                <h4>General Dentistry</h4>
                <p>
                  Comprehensive exams, cleanings, fillings, and preventive care to keep your whole
                  family healthy for life.
                </p>
                <a class="btn-plus" href="/services/general-dentistry">
                  <i class="fa fa-plus"></i>
                  <span>Read more</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-sm-6">
          <div class="hover">
            <div class="bg-white h-100 p-40 rounded-1">
              <img src="/images/icons/tooth-2.png" class="w-70px mb-3 wow scaleIn" alt="" />
              <div class="relative mt-4 wow fadeInUp">
                <h4>Cosmetic Dentistry</h4>
                <p>
                  Teeth whitening, porcelain veneers, Invisalign, and full smile makeovers tailored
                  to your unique goals.
                </p>
                <a class="btn-plus" href="/services/cosmetic-dentistry">
                  <i class="fa fa-plus"></i>
                  <span>Read more</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-sm-6">
          <div class="hover">
            <div class="bg-white h-100 p-40 rounded-1">
              <img src="/images/icons/tooth-3.png" class="w-70px mb-3 wow scaleIn" alt="" />
              <div class="relative mt-4 wow fadeInUp">
                <h4>Pediatric Dentistry</h4>
                <p>
                  Gentle, kid-friendly dental care designed to build healthy habits and positive
                  experiences from the first tooth.
                </p>
                <a class="btn-plus" href="/services/pediatric-dentistry">
                  <i class="fa fa-plus"></i>
                  <span>Read more</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-sm-6">
          <div class="hover">
            <div class="bg-white h-100 p-40 rounded-1">
              <img src="/images/icons/tooth-4.png" class="w-70px mb-3 wow scaleIn" alt="" />
              <div class="relative mt-4 wow fadeInUp">
                <h4>Restorative Dentistry</h4>
                <p>
                  Dental implants, CEREC same-day crowns and root canals that repair and restore
                  your teeth.
                </p>
                <a class="btn-plus" href="/services/restorative-dentistry">
                  <i class="fa fa-plus"></i>
                  <span>Read more</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-12 mt-5 text-center">
          <a class="btn-main fx-slide" href="/services">
            <span>View All Services</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-dark text-light pt-60 pb-60">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-3 col-sm-6 text-center">
          <div class="de_count wow fadeInRight" data-wow-delay=".0s">
            <h3 class="fs-40 mb-0">
              <span class="timer" data-to={practice.stats.patientsTo} data-speed="3000">
                0
              </span>
              +
            </h3>
            Happy Patients
          </div>
        </div>
        <div class="col-md-3 col-sm-6 text-center">
          <div class="de_count wow fadeInRight" data-wow-delay=".2s">
            <h3 class="fs-40 mb-0">
              <span class="timer" data-to={practice.stats.dentistsTo} data-speed="3500">
                0
              </span>
            </h3>
            Expert Dentists
          </div>
        </div>
        <div class="col-md-3 col-sm-6 text-center">
          <div class="de_count wow fadeInRight" data-wow-delay=".4s">
            <h3 class="fs-40 mb-0">
              <span class="timer" data-to={practice.stats.servicesTo} data-speed="3000">
                0
              </span>
              +
            </h3>
            Dental Services
          </div>
        </div>
        <div class="col-md-3 col-sm-6 text-center">
          <div class="de_count wow fadeInRight" data-wow-delay=".6s">
            <h3 class="fs-40 mb-0">
              <span class="timer" data-to={practice.stats.yearsTo} data-speed="3000">
                0
              </span>
              +
            </h3>
            Years of Experience
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row gy-4 gx-5 align-items-center">
        <div class="col-lg-6">
          <div class="subtitle id-color wow fadeInUp" data-wow-delay=".0s">
            Why Choose Our Dental Care
          </div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Exceptional Service With a Personal Touch
          </h2>
          <p class="wow fadeInUp" data-wow-delay=".4s">
            Choosing the right dental provider matters. We combine expert care, advanced technology,
            and a warm atmosphere to ensure every visit is comfortable, efficient, and tailored to
            your unique needs.
          </p>

          <div class="border-bottom mb-4"></div>

          <div class="row g-4">
            <div class="col-sm-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Clinical Excellence</h5>
                  <p class="mb-0">State-of-the-art dentistry with trusted, lasting results.</p>
                </div>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Patient Comfort</h5>
                  <p class="mb-0">Gentle care with zero judgment, ever.</p>
                </div>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Advanced Technology</h5>
                  <p class="mb-0">Digital X-rays, CEREC same-day crowns and 3D imaging.</p>
                </div>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Community Trust</h5>
                  <p class="mb-0">Serving Queens families since 1987, across generations.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="row g-4 align-items-center">
            <div class="col-6 text-end">
              <div class="w-80 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img src="/images/misc/s2.webp" class="w-100 wow scaleIn" alt="" />
              </div>
              <div class="w-100 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img src="/images/misc/s3.webp" class="w-100 wow scaleIn" alt="" />
              </div>
            </div>

            <div class="col-6">
              <div class="w-100 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img src="/images/misc/p3.webp" class="w-100 wow scaleIn" alt="" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-color-op-1">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 offset-lg-3 text-center">
          <div class="subtitle wow fadeInUp mb-3">Meet Our Dental Team</div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Meet the Dentists Who Care
          </h2>
          <p class="wow fadeInUp">
            Four experienced dentists. One shared commitment to your comfort and long-term oral
            health.
          </p>
          <div class="spacer-single"></div>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img
                src="/images/team/bhagat.webp"
                class="w-100 wow scaleIn"
                alt="Dr. Deepak Bhagat DDS"
              />
            </div>
            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">
                  {lead.name} {lead.suffix}
                </h4>
                <p class="mb-2">{lead.role}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img src="/images/team/2.webp" class="w-100 wow scaleIn" alt="" />
            </div>
            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">
                  {islam.name} {islam.suffix}
                </h4>
                <p class="mb-2">{islam.role}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img src="/images/team/3.webp" class="w-100 wow scaleIn" alt="" />
            </div>
            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">
                  {li.name} {li.suffix}
                </h4>
                <p class="mb-2">{li.role}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img src="/images/team/avendano.webp" class="w-100 wow scaleIn" alt="" />
            </div>
            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">
                  {avendano.name} {avendano.suffix}
                </h4>
                <p class="mb-2">{avendano.role}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-5">
          <div class="subtitle id-color wow fadeInUp" data-wow-delay=".0s">
            Everything You Need to Know
          </div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="col-lg-7">
          <div class="accordion s2 wow fadeInUp">
            <div class="accordion-section">
              <div class="accordion-section-title" data-tab="#accordion-a1">
                How often should I visit the dentist?
              </div>
              <div class="accordion-section-content" id="accordion-a1">
                We recommend visiting every 6 months for routine checkups and professional
                cleanings. Some patients with specific oral health concerns may benefit from more
                frequent visits — our team will guide you during your first appointment.
              </div>
              <div class="accordion-section-title" data-tab="#accordion-a2">
                What should I do in a dental emergency?
              </div>
              <div class="accordion-section-content" id="accordion-a2">
                Call us immediately at {practice.phone.display} — we offer same-day emergency
                appointments for urgent issues like severe toothaches, broken or knocked-out teeth,
                or dental trauma.
              </div>
              <div class="accordion-section-title" data-tab="#accordion-a3">
                Do you offer services for kids?
              </div>
              <div class="accordion-section-content" id="accordion-a3">
                Absolutely! We provide gentle, friendly pediatric dental care for children of all
                ages, designed to build healthy habits from the first tooth.
              </div>
              <div class="accordion-section-title" data-tab="#accordion-a4">
                What are my options for replacing missing teeth?
              </div>
              <div class="accordion-section-content" id="accordion-a4">
                We offer dental implants, implant-supported bridges and All-on-4 full-arch
                restoration depending on your needs and preferences.
              </div>
              <div class="accordion-section-title" data-tab="#accordion-a5">
                Is teeth whitening safe?
              </div>
              <div class="accordion-section-content" id="accordion-a5">
                Yes — our in-office whitening takes under an hour, plus take-home trays to
                maintain your smile. Results vary by tooth, so ask us for your personal shade
                assessment at your visit.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-color-op-1">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 offset-lg-3 text-center">
          <div class="subtitle wow fadeInUp mb-3">Patient Stories</div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Real Stories From Your Neighbors
          </h2>
          <p class="wow fadeInUp">
            Families across Queens trust Smile Savers. Here&apos;s what they say.
          </p>
          <div class="spacer-single"></div>
        </div>
      </div>
    </div>
    <div class="container-fluid">
      <div class="row">
        <div class="owl-carousel owl-theme wow fadeInUp four-cols-center-dots text-center">
          <div class="item">
            <div class="gradient-white-top p-40 py-4 rounded-1">
              <blockquote>
                <i class="fs-32 icofont-quote-left absolute start-0 mt-2 p-0 id-color"></i>
                <div class="de_testi_by">
                  <img class="circle" alt="" src="/images/testimonial/1.webp" />
                  <div>
                    Mohammed Rab<span>Verified via Google</span>
                  </div>
                </div>
                <p class="mt-4 mb-0 text-dark op-6">
                  &quot;Dr. Deepak Bhagat is excellent dentist! My family and I have been his
                  patient over 21 years. I would definitely recommend him to my friends and
                  family.&quot;
                </p>
              </blockquote>
            </div>
          </div>
          <div class="item">
            <div class="gradient-white-top p-40 py-4 rounded-1">
              <blockquote>
                <i class="fs-32 icofont-quote-left absolute start-0 mt-2 p-0 id-color"></i>
                <div class="de_testi_by">
                  <img class="circle" alt="" src="/images/testimonial/2.webp" />
                  <div>
                    Joe Velotta<span>Verified via Google</span>
                  </div>
                </div>
                <p class="mt-4 mb-0 text-dark op-6">
                  &quot;Amazing place Always ready to see me. NO Waiting time at all. Dr. Li is
                  the best. Thanks to all the staff.&quot;
                </p>
              </blockquote>
            </div>
          </div>
          <div class="item">
            <div class="gradient-white-top p-40 py-4 rounded-1">
              <blockquote>
                <i class="fs-32 icofont-quote-left absolute start-0 mt-2 p-0 id-color"></i>
                <div class="de_testi_by">
                  <img class="circle" alt="" src="/images/testimonial/3.webp" />
                  <div>
                    Walter Ocaña<span>Verified via Google</span>
                  </div>
                </div>
                <p class="mt-4 mb-0 text-dark op-6">
                  &quot;Super recomendado la atencion 100 de 100. La Dr. Islam muy amable. La
                  officina muy limpia. La assistentes me explicaron todo y traducieron para mi. Mil
                  gracias les recomiendo.&quot;
                </p>
              </blockquote>
            </div>
          </div>
          <div class="item">
            <div class="gradient-white-top p-40 py-4 rounded-1">
              <blockquote>
                <i class="fs-32 icofont-quote-left absolute start-0 mt-2 p-0 id-color"></i>
                <div class="de_testi_by">
                  <img class="circle" alt="" src="/images/testimonial/4.webp" />
