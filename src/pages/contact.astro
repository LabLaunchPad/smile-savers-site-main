---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import { practice, fullAddress, hoursSentence } from '../data/practice';

export const prerender = true;
---

<Layout
  title="Contact Us — Smile Savers Dental"
  description={`Contact ${practice.name}, ${fullAddress()}. Call ${practice.phone.display} or message us today.`}
  headerClass="transparent header-light"
>
  <section id="subheader" class="bg-color-op-1 text-center">
    <div class="container relative z-2">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <h1 class="wow fadeInUp">Contact Us</h1>
          <div class="border-bottom my-3"></div>
          <ul class="crumb wow fadeInDown">
            <li>
              <a href="/">Home</a>
            </li>
            <li class="active">Contact</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="subtitle">Get In Touch</div>
          <h2 class="wow fadeInUp">We are always ready to help you and answer your questions</h2>

          <p>
            Whether you have a question, a suggestion, or just want to say hello, this is the place
            to do it. Please fill out the form below with your details and message, and we&apos;ll
            get back to you as soon as possible.
          </p>

          <div class="row g-4 gx-5">
            <div class="col-lg-6">
              <div class="fw-bold text-dark">
                <i class="icofont-clock-time me-2 id-color-2"></i>We&apos;re Open
              </div>
              {hoursSentence()}
            </div>

            <div class="col-lg-6">
              <div class="fw-bold text-dark">
                <i class="icofont-location-pin me-2 id-color-2"></i>Clinic Location
              </div>
              {fullAddress()}
            </div>

            <div class="col-lg-6">
              <div class="fw-bold text-dark">
                <i class="icofont-phone me-2 id-color-2"></i>Call Us Directly
              </div>
              <a href={practice.phone.href}>{practice.phone.display}</a>
            </div>

            <div class="col-lg-6">
              <div class="fw-bold text-dark">
                <i class="icofont-envelope me-2 id-color-2"></i>Send a Message
              </div>
              <a href={practice.email.href}>{practice.email.address}</a>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Layout>
