---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/shared/PageHeader.astro';

export const prerender = true;
---

<Layout
  title="About Us | Dentist in Woodside, Queens | Smile Savers Dental"
  description="Meet our Woodside, Queens dental team with 35+ years of care. We speak all our Queens community languages. Call (718) 956-8400."
  headerClass="transparent header-light"
>
  <PageHeader title="About Us" />

  <section>
    <div class="container">
      <div class="row g-4 gx-5 align-items-center">
        <div class="col-lg-6">
          <div class="row g-4">
            <div class="col-6">
              <div class="row g-4">
                <div class="col-lg-12">
                  <div class="rounded-1 overflow-hidden wow zoomIn">
                    <img
                      src="/images/misc/p1.webp"
                      class="w-100 wow scaleIn"
                      width="1000"
                      height="1350"
                      loading="lazy"
                      decoding="async"
                      alt="Smiling patient during a dental exam with a mirror"
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="row g-4">
                <div class="spacer-single sm-hide"></div>

                <div class="col-lg-12">
                  <div class="rounded-1 overflow-hidden wow zoomIn" data-wow-delay=".3s">
                    <img
                      src="/images/misc/p2.webp"
                      class="w-100 wow scaleIn"
                      width="1000"
                      height="1350"
                      loading="lazy"
                      decoding="async"
                      alt="Dentist standing beside a seated patient"
                      data-wow-delay=".3s"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="me-lg-3">
            <div class="subtitle s2 mb-3 wow fadeInUp" data-wow-delay=".0s">
              About Us
            </div>
            <h2 class="wow fadeInUp" data-wow-delay=".2s">
              Serving Queens with Gentle, Modern Dentistry Since 1987
            </h2>
            <p class="wow fadeInUp" data-wow-delay=".4s">
              Smile Savers Dental has served Woodside, Queens since 1987. Multiple generations trust
              our gentle, pain-free care, from routine checkups to same-day emergency visits.
            </p>
            <ul class="ul-check text-dark cols-2 fw-600 mb-4 wow fadeInUp" data-wow-delay=".6s">
              <li>Personalized Treatment Plans</li>
              <li>Gentle Care for Kids and Adults</li>
              <li>State-of-the-Art Technology</li>
              <li>Flexible Appointment Scheduling</li>
            </ul>

            <a class="btn-main fx-slide wow fadeInUp" data-wow-delay=".8s" href="/contact">
              <span>Book Appointment</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-color-op-1">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 offset-lg-3 text-center">
          <div class="subtitle wow fadeInUp mb-3">Meet Our Dental Team</div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            Meet the Dentists Who Care
          </h2>
          <p class="wow fadeInUp">
            Four experienced dentists. One shared commitment to your comfort and long-term oral
            health.
          </p>
          <div class="spacer-single"></div>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-lg-3">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img
                src="/images/team/bhagat.webp"
                class="w-100 wow scaleIn"
                width="740"
                height="1000"
                loading="lazy"
                decoding="async"
                alt="Dr. Deepak Bhagat, Lead Dentist at Smile Savers Dental"
              />
            </div>

            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">Dr. Deepak Bhagat DDS</h4>
                <p class="mb-2">Lead Dentist</p>
                <a class="id-color fw-600" href="/dentists">
                  View Profile
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img
                src="/images/team/2.webp"
                class="w-100 wow scaleIn"
                width="1000"
                height="1350"
                loading="lazy"
                decoding="async"
                alt="Dr. Julie Islam, General Dentist at Smile Savers Dental"
              />
            </div>

            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">Dr. Julie Islam DMD</h4>
                <p class="mb-2">Dentist</p>
                <a class="id-color fw-600" href="/dentists">
                  View Profile
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img
                src="/images/team/3.webp"
                class="w-100 wow scaleIn"
                width="1000"
                height="1350"
                loading="lazy"
                decoding="async"
                alt="Dr. Dorothy Li, Restorative Dentist at Smile Savers Dental"
              />
            </div>

            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">Dr. Dorothy Li DDS</h4>
                <p class="mb-2">Dentist</p>
                <a class="id-color fw-600" href="/dentists">
                  View Profile
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-3">
          <div class="relative rounded-1 overflow-hidden">
            <div class="rounded-1 overflow-hidden wow fadeIn zoomIn">
              <img
                src="/images/team/avendano.webp"
                class="w-100 wow scaleIn"
                width="1103"
                height="1426"
                loading="lazy"
                decoding="async"
                alt="Dr. Sarha Avendaño, General Dentist at Smile Savers Dental"
              />
            </div>

            <div class="abs w-100 start-0 bottom-0 z-3">
              <div class="p-2 rounded-10 m-3 text-center bg-white wow fadeInDown">
                <h4 class="mb-0">Dr. Sarha Avendaño DDS</h4>
                <p class="mb-2">Dentist</p>
                <a class="id-color fw-600" href="/dentists">
                  View Profile
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row gy-4 gx-5 align-items-center">
        <div class="col-lg-6">
          <div class="subtitle id-color wow fadeInUp" data-wow-delay=".0s">
            Why Choose Our Dental Care
          </div>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">
            The Principles That Guide Everything We Do
          </h2>
          <p class="wow fadeInUp" data-wow-delay=".4s">
            Choosing your Woodside dentist matters. For 35+ years, 10,000+ patients have trusted our
            gentle care, modern technology, and same-day emergency appointments.
          </p>

          <div class="border-bottom mb-4"></div>

          <div class="row g-4">
            <div class="col-lg-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Clinical Excellence</h5>
                  <p class="mb-0">
                    The highest standards in dental care, proven techniques and premium materials
                    for results that last.
                  </p>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Advanced Technology</h5>
                  <p class="mb-0">
                    From digital X-rays to CEREC same-day crowns and 3D imaging for better outcomes.
                  </p>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Patient Comfort</h5>
                  <p class="mb-0">
                    Your comfort first — a calm, welcoming space with gentle options for anxious
                    patients.
                  </p>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="h-100">
                <div class="relative wow fadeInUp">
                  <h5>Community Trust</h5>
                  <p class="mb-0">
                    Three generations of Queens families trust us with their smiles, every visit.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="row g-4 align-items-center">
            <div class="col-6 text-end">
              <div class="w-80 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img
                  src="/images/misc/s2.webp"
                  class="w-100 wow scaleIn"
                  width="1000"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                  alt="Close-up of a smiling patient during a dental exam"
                />
              </div>
              <div class="w-100 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img
                  src="/images/misc/s3.webp"
                  class="w-100 wow scaleIn"
                  width="1000"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                  alt="Masked dentist and assistant leaning over a patient"
                />
              </div>
            </div>

            <div class="col-6">
              <div class="w-100 rounded-1 overflow-hidden mb-25 wow zoomIn d-inline-block">
                <img
                  src="/images/misc/p3.webp"
                  class="w-100 wow scaleIn"
                  width="1000"
                  height="1350"
                  loading="lazy"
                  decoding="async"
                  alt="Patient in a dental chair giving a thumbs up"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
