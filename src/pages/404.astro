---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Page Not Found — Smile Savers Dental" headerClass="transparent header-light">
  <section id="subheader" class="bg-color-op-1 text-center">
    <div class="container relative z-2">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <h1 class="wow fadeInUp">404 — Page Not Found</h1>
          <div class="border-bottom my-3"></div>
          <ul class="crumb wow fadeInDown">
            <li>
              <a href="/">Home</a>
            </li>
            <li class="active">404</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="row g-4 justify-content-center">
        <div class="col-lg-8 text-center">
          <h2 class="wow fadeInUp">Oops! That page went missing</h2>
          <p class="wow fadeInUp">
            The page you’re looking for doesn’t exist or was moved. Let’s get you back to a healthy
            smile.
          </p>
          <div class="spacer-single"></div>
          <a class="btn-main fx-slide wow fadeInUp" href="/">
            <span>Back to Home</span>
          </a>
          <a class="btn-main btn-line fx-slide wow fadeInUp" href="/booking">
            <span>Book Appointment</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
