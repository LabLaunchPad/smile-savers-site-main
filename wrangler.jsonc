{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smile-savers-site-main",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
